{
  "title": "SLOs",
  "uid": "homelab-slo",
  "tags": [
    "slo",
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Availability, last 30 days (objective 99.5 %)",
      "description": "Share of requests answered without a 5xx, measured at Traefik. Red = below the objective.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "1 - slo:error_ratio:rate30d{slo=\"availability\"}",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Error budget left (30 days)",
      "description": "100 % = no failures this month. 0 % = the allowed failures are used up: freeze risky changes. Below 0 = SLO missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:error_budget_remaining:ratio",
          "legendFormat": "{{site}} {{slo}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": -1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate, 1 h (1 = spending the budget exactly in 30 days)",
      "description": "Lines: 1 = on track to use exactly the whole budget; 6 = alert if it lasts 6 h; 14.4 = alert if it lasts 1 h.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:error_ratio:rate1h{slo=\"availability\"} / 0.005",
          "legendFormat": "{{site}} availability",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "slo:error_ratio:rate1h{slo=\"latency\"} / 0.01",
          "legendFormat": "{{site}} latency",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Requests per second per site (at Traefik)",
      "description": "The denominator of the SLO. Very little traffic = the SLO says little (alerts need >= 10 requests per hour).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (site) (label_replace(rate(traefik_service_requests_total{service=~\"apps-.+\"}[5m]), \"site\", \"$1\", \"service\", \"apps-(landing|notes|ticketlite)-.+\"))",
          "legendFormat": "{{site}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (site) (label_replace(rate(traefik_service_requests_total{service=~\"apps-.+\",code=~\"5..\"}[5m]), \"site\", \"$1\", \"service\", \"apps-(landing|notes|ticketlite)-.+\"))",
          "legendFormat": "{{site}} 5xx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "TicketLite api: share of requests faster than 300 ms (objective 99 %)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "1 - slo:error_ratio:rate1h{slo=\"latency\"}",
          "legendFormat": "1 h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "1 - slo:error_ratio:rate1d{slo=\"latency\"}",
          "legendFormat": "1 day",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.9,
          "max": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "SLO alerts firing now",
      "description": "Same alerts as in Telegram. Empty = fine.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "ALERTS{alertstate=\"firing\", slo!=\"\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            }
          }
        }
      ]
    }
  ],
  "description": "Service level objectives of the public sites: docs/learn/11-slo.md"
}
