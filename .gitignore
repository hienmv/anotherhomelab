# Credentials: never commit
*.kubeconfig
kubeconfig*
k3s.yaml
homelab.yaml
*.pem
*.key
id_*
credentials.json
*-creds.json
tunnel*.json
.env
.env.*
*.secret.yaml
secrets/
# ...except encrypted secrets (SOPS, docs/learn/12-gitops-secrets.md) and the tooling. In k8s/secrets
# only *.sops.yaml and the kustomization are allowed: a plain file put there stays ignored.
!k8s/secrets/
k8s/secrets/**
!k8s/secrets/**/
!k8s/secrets/kustomization.yaml
!k8s/secrets/**/*.sops.yaml
!scripts/secrets/
# ansible/secrets: only encrypted files (machine secrets, e.g. the backup store's keys)
!ansible/secrets/
ansible/secrets/**
!ansible/secrets/*.sops.yaml

# Backups / archives
*.tgz
*.tar.gz
*.dump
*.sql
*.db

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Build output (Gradle, Kotlin, IDE, Node)
build/
bin/
.gradle/
.kotlin/
node_modules/
dist/

# Exception: database migrations are source code, not dumps
!**/db/migration/*.sql
.astro/

# public CA certificate for grafana.lan (no private key; see K3S-GUIDE section 7)
!ansible/files/grafana-lan-ca.pem

# Ansible run logs (ansible.cfg log_path)
ansible/logs/*
!ansible/logs/.gitkeep
