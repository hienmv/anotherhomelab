---
import apps from '../data/apps.json'
---
<div class="menu" data-menu>
  <a href="/homelab/" class="nav-link menu__button" data-menu-button aria-controls="homelab-menu">
    Homelab <span aria-hidden="true">▾</span>
  </a>
  <ul id="homelab-menu" class="menu__list" data-menu-list hidden>
    {apps.map((app) => (
      <li>
        <a href={app.url} class="menu__item">
          <span class="menu__name">{app.name}</span>
          <span class="menu__desc">{app.description}</span>
        </a>
      </li>
    ))}
    <li class="menu__more"><a href="/homelab/" class="menu__item">All homelab apps</a></li>
  </ul>
</div>
<script>
  import { initMenu } from '../scripts/menu'
  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((el) => initMenu(el))
</script>
