---
import profile from '../data/profile.json'
import HomelabMenu from './HomelabMenu.astro'
interface Props { current: 'notes' | 'homelab' | 'about' | null }
const { current } = Astro.props
const cls = (name: string) => `nav-link${current === name ? ' nav-link--active' : ''}`
---
<header class="header">
  <a href="/" class="brand">{profile.siteTitle}</a>
  <nav class="nav" aria-label="Main">
    <a href="/" class={cls('notes')} aria-current={current === 'notes' ? 'page' : undefined}>Notes</a>
    <HomelabMenu />
    <a href="/about/" class={cls('about')} aria-current={current === 'about' ? 'page' : undefined}>About</a>
  </nav>
</header>
