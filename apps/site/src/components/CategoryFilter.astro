---
interface Props { categories: string[]; current: string | null }
const { categories, current } = Astro.props
---
<nav class="filter" aria-label="Filter notes by category">
  <a href="/" class={`chip${current === null ? ' chip--active' : ''}`} aria-current={current === null ? 'page' : undefined}>All</a>
  {categories.map((c) => (
    <a href={`/notes/category/${c}/`} class={`chip${current === c ? ' chip--active' : ''}`} aria-current={current === c ? 'page' : undefined}>{c}</a>
  ))}
</nav>
