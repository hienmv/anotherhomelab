---
import Base from '../../layouts/Base.astro'
import CategoryFilter from '../../components/CategoryFilter.astro'
import NoteList from '../../components/NoteList.astro'
import { allNotes, categories } from '../../scripts/notes'

export async function getStaticPaths() {
  const cats = await categories()
  return cats.map((category) => ({ params: { category } }))
}
const { category } = Astro.params
const notes = (await allNotes()).filter((n) => n.data.category === category)
---
<Base title={`Notes: ${category}`} current="notes">
  <div class="page-head">
    <h1>Notes</h1>
    <CategoryFilter categories={await categories()} current={category!} />
  </div>
  <NoteList notes={notes} />
</Base>
