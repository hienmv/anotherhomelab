---
import { formatDate, type Note } from '../scripts/notes'
interface Props { notes: Note[] }
const { notes } = Astro.props
---
<ul class="note-list">
  {notes.map((n) => (
    <li class="note-list__item">
      <p class="meta">
        <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time> ·
        <a href={`/category/${n.data.category}/`}>{n.data.category}</a>
      </p>
      <h2 class="note-list__title" lang={n.data.lang}><a href={`/${n.id}/`}>{n.data.title}</a></h2>
      {n.data.description && <p class="muted">{n.data.description}</p>}
    </li>
  ))}
</ul>
