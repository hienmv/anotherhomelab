# Rendered by the nginx image entrypoint (envsubst replaces only defined env vars, e.g. API_UPSTREAM).
# JSON access log, one object per line, same fields and level rule as TicketLite's backend
# (docs/learn/9-monitoring-grafana.md). Same block in landing, notes and ticketlite/web.
#   level: 5xx -> ERROR, slower than 1 s -> WARN, else INFO (4xx are correct answers: INFO)
#   path: what the visitor asked for, without the ?query (not the file nginx served)
#   request_id: X-Request-ID from the caller, else Cloudflare's CF-Ray, else nginx's own random id
#   Kubernetes probes (User-Agent kube-probe) are not logged: noise every 10 s.
# nginx's error log (startup, upstream failures) stays plain text: nginx cannot write it as JSON.
map "$status $request_time" $log_level {
    "~^5"            ERROR;
    "~^\d+ [1-9]"    WARN;
    default          INFO;
}
map $request_time $duration_ms {
    "~^0\.0*(\d+)$"        $1;
    "~^(\d+)\.(\d{3})$"    $1$2;
    default                0;
}
map $http_cf_ray $edge_request_id {
    ""       $request_id;
    default  $http_cf_ray;
}
map $http_x_request_id $req_id {
    ""       $edge_request_id;
    default  $http_x_request_id;
}
map $request_uri $req_path {
    "~^(?<p>[^?]*)"  $p;
    default          $request_uri;
}
map $http_user_agent $loggable {
    "~^kube-probe"  0;
    default         1;
}
log_format json escape=json '{"time":"$time_iso8601","level":"$log_level","logger":"nginx",'
    '"message":"$request_method $req_path -> $status in $duration_ms ms",'
    '"service":"ticketlite-web","method":"$request_method","path":"$req_path","status":$status,'
    '"duration_ms":$duration_ms,"bytes":$body_bytes_sent,"request_id":"$req_id",'
    '"client_ip":"$http_cf_connecting_ip","user_agent":"$http_user_agent","referer":"$http_referer"}';

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout json if=$loggable;
    root /usr/share/nginx/html;

    # Used by docker compose. In Kubernetes the Ingress routes /api straight to the api Service.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $req_id;   # same id in the api's log lines
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
