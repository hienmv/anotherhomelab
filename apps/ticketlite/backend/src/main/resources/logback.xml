<!--
  Logs are structured JSON, one object per line, so the central log store (VictoriaLogs) gets real
  fields, named like OpenTelemetry (docs/learn/9-monitoring-grafana.md, 10-tracing.md):

    {"time":"2026-11-16T06:23:21.028Z","level":"INFO","logger":"ticketlite.http","message":"GET /api/concerts -> 200 in 13 ms",
     "service.name":"ticketlite-api","service.namespace":"ticketlite","http.request.method":"GET","url.path":"/api/concerts",
     "http.response.status_code":200,"duration_ms":13,"request_id":"8e2f...","trace_id":"4bf9...","span_id":"00f0..."}

  trace_id / span_id are added by the OpenTelemetry Java agent (MDC); without the agent they are absent.

  Levels (same rule everywhere in this homelab):
    ERROR  the service failed and someone should look (5xx, unhandled exception, lost connection)
    WARN   degraded but still working (slow request, a retry)
    INFO   normal events (requests incl. 4xx like SOLD_OUT, orders processed, start/stop)
    DEBUG  details for a bug hunt; off unless LOG_LEVEL=DEBUG

  Env: LOG_FORMAT=json (default, also in docker compose) | text (readable), LOG_LEVEL=INFO (default).
-->
<configuration>
    <!-- appender "out": JSON (logback-json.xml) or readable text (logback-text.xml) -->
    <include resource="logback-${LOG_FORMAT:-json}.xml"/>

    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="io.ktor" level="INFO"/>
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="out"/>
    </root>
</configuration>
