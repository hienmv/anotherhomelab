<!-- Included by logback.xml when LOG_FORMAT=json (the default). -->
<included>
    <appender name="out" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>time</timestamp>
                <logger>logger</logger>
                <thread>[ignore]</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSX</timestampPattern>
            <timeZone>UTC</timeZone>
            <!-- service.name = the name in the traces (OTEL_SERVICE_NAME): ticketlite-api / ticketlite-worker -->
            <customFields>{"service.name":"${OTEL_SERVICE_NAME:-ticketlite-${ROLE:-unknown}}","service.namespace":"ticketlite"}</customFields>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>
</included>
