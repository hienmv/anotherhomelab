# Rendered by the nginx image entrypoint: envsubst fills ${NOTES_UPSTREAM}, ${SITE_DOMAIN} (set at
# build time from site-settings) and ${NGINX_LOCAL_RESOLVERS} (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1);
# other $vars (nginx's own) are left alone: envsubst only fills variables that are defined.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;

    # Resolve the notes Service per request, so nginx starts even if notes is not up yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    # Content moved to the notes subdomain (old apex paths and old Jekyll URLs keep working).
    rewrite "^/notes/(.*)$" https://notes.${SITE_DOMAIN}/$1 permanent;
    rewrite "^/(tech|work-style)/\d{4}/\d{2}/\d{2}/([^/]+)\.html$" https://notes.${SITE_DOMAIN}/$2/ permanent;
    rewrite "^/(rss\.xml|category/.*)$" https://notes.${SITE_DOMAIN}/$1 permanent;

    # Featured notes, fetched from the notes app inside the cluster (same origin for the browser).
    location = /featured.json {
        set $notes_upstream ${NOTES_UPSTREAM};
        proxy_pass $notes_upstream/featured.json;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        add_header Cache-Control "public, max-age=60";
    }

    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
