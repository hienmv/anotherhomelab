# Rendered by the nginx image entrypoint: envsubst fills ${NOTES_UPSTREAM} and
# ${NGINX_LOCAL_RESOLVERS} (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1); other $vars (nginx's own) are left
# alone: envsubst only fills variables that are defined.
# JSON access log, one object per line, same fields (OpenTelemetry names) and level rule as
# TicketLite's backend (docs/learn/9-monitoring-grafana.md). Same block in landing, notes and ticketlite/web.
#   level: 5xx -> ERROR, slower than 1 s -> WARN, else INFO (4xx are correct answers: INFO)
#   path: what the visitor asked for, without the ?query (not the file nginx served)
#   request_id: X-Request-ID from the caller, else Cloudflare's CF-Ray, else nginx's own random id
#   Kubernetes probes (User-Agent kube-probe) are not logged: noise every 10 s.
# nginx's error log (startup, upstream failures) stays plain text: nginx cannot write it as JSON.
map "$status $request_time" $log_level {
    "~^5"            ERROR;
    "~^\d+ [1-9]"    WARN;
    default          INFO;
}
map $request_time $duration_ms {
    "~^0\.0*(\d+)$"        $1;
    "~^(\d+)\.(\d{3})$"    $1$2;
    default                0;
}
map $http_cf_ray $edge_request_id {
    ""       $request_id;
    default  $http_cf_ray;
}
map $http_x_request_id $req_id {
    ""       $edge_request_id;
    default  $http_x_request_id;
}
map $request_uri $req_path {
    "~^(?<p>[^?]*)"  $p;
    default          $request_uri;
}
map $http_user_agent $loggable {
    "~^kube-probe"  0;
    default         1;
}
log_format json escape=json '{"time":"$time_iso8601","level":"$log_level","logger":"nginx",'
    '"message":"$request_method $req_path -> $status in $duration_ms ms",'
    '"service.name":"landing","http.request.method":"$request_method","url.path":"$req_path",'
    '"http.response.status_code":$status,"duration_ms":$duration_ms,'
    '"http.response.body.size":$body_bytes_sent,"request_id":"$req_id",'
    '"client.address":"$http_cf_connecting_ip","user_agent.original":"$http_user_agent",'
    '"http.request.header.referer":"$http_referer"}';

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout json if=$loggable;
    root /usr/share/nginx/html;
    absolute_redirect off;

    # Resolve the notes Service per request, so nginx starts even if notes is not up yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    # Featured notes, fetched from the notes app inside the cluster (same origin for the browser).
    location = /featured.json {
        set $notes_upstream ${NOTES_UPSTREAM};
        proxy_pass $notes_upstream/featured.json;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        add_header Cache-Control "public, max-age=60";
    }

    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
